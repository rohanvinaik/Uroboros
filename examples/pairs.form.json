            "what": "ValueError for a key given twice"
          }
        ]
      },
      "intent_test": {
        "source": "def test_read_settings():\n    text = 'name = disc one\\n\\n# a comment\\n  # an indented comment\\nkind=film\\n'\n    assert read_settings(text) == {'name': 'disc one', 'kind': 'film'}\n    assert read_settings('') == {}\n    assert read_settings('\\n\\n') == {}\n\n\ndef test_read_settings_depends_on_its_lines():\n    assert read_settings('a = 1') != read_settings('a = 2')\n\n\ndef test_read_settings_keeps_every_key():\n    assert len(read_settings('a = 1\\nb = 2\\nc = 3')) == 3\n\n\ndef test_read_settings_refuses_a_key_given_twice():\n    with pytest.raises(ValueError):\n        read_settings('a = 1\\na = 2')\n\n\ndef test_read_settings_refuses_a_line_that_is_not_a_pair():\n    with pytest.raises(ValueError):\n        read_settings('a = 1\\nnot a pair')\n",
