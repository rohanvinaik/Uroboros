        "prose": "One line read as a key and its value: split at the first '=', each side stripped of surrounding spaces. A line without '=', or with nothing before it, is refused with ValueError.",
        "operations": [
          {
            "category": "SWAP",
            "what": "the split at the first '='"
          },
          {
            "category": "BOUNDARY",
            "what": "a key that is empty"
          },
          {
            "category": "EXCEPTION",
            "what": "ValueError for a line that is not a pair"
          }
        ]
      },
      "intent_test": {
        "source": "def test_read_pair():\n    assert read_pair('name = disc one') == ('name', 'disc one')\n    assert read_pair('a=b') == ('a', 'b')\n    assert read_pair('url = http://x?y=1') == ('url', 'http://x?y=1')\n    assert read_pair('empty =') == ('empty', '')\n\n\ndef test_read_pair_depends_on_the_line():\n    assert read_pair('a = 1') != read_pair('b = 1')\n    assert read_pair('a = 1') != read_pair('a = 2')\n\n\ndef test_read_pair_strips_only_the_ends():\n    assert read_pair('  key  =  two words  ') == ('key', 'two words')\n\n\ndef test_read_pair_refuses_what_is_not_a_pair():\n    for bad in ('no equals sign', '= value', '   = value', ''):\n        with pytest.raises(ValueError):\n            read_pair(bad)\n",
        "covers": [
          {
            "category": "SWAP",
            "subject": "the split at the first '='",
            "operator": "Call",
            "range": "one '=' and two"
          },
          {
            "category": "BOUNDARY",
            "subject": "a key that is empty",
            "operator": "Not",
            "range": "'= value', '   = value'"
          },
          {
            "category": "EXCEPTION",
            "subject": "a line that is not a pair",
            "operator": "Raise",
            "range": "no '=', nothing before it, an empty line"
          }
        ],
        "never": [
