sses decides, from 0.0 to 1.0. No scores give a rate of 0.0.\n\n    Operations:\n        ARITHMETIC: the passing count over the count\n        BOUNDARY: no scores\n    \"\"\"\n    if not scores:\n        return 0.0\n    return sum((1 for score in scores if passes(score))) / len(scores)\n","tests/test_grades.py":"from grades import passes, pass_rate\n\n\ndef test_passes():\n    assert passes(50) is True\n    assert passes(49) is False\n    assert passes(100) is True\n    assert passes(0) is False\n    assert passes(49.5) is False\n\n\ndef test_passes_depends_on_the_score():\n    assert passes(10) != passes(90)\n\n\ndef test_passes_is_a_bool():\n    assert isinstance(passes(75), bool)\n\n\ndef test_pass_rate():\n    assert pass_rate([50, 49, 100, 0]) == 0.5\n    assert pass_rate([]) == 0.0\n    assert pass_rate([80]) == 1.0\n    assert pass_rate([10, 20, 30]) == 0.0\n\n\ndef test_pass_rate_depends_on_the_scores():\n    assert pass_rate([60, 60]) != pass_rate([60, 40])\n\n\ndef test_pass_rate_stays_a_fraction():\n    for scores in ([], [0], [100], [0, 100], [50] * 7):\n        assert 0.0 <= pass_rate(scores) <= 1.0\n"},"asked":{},"steps":[{"argv":["regime","--project-root","{root}","--json"],"exit":0,"stderr":"","payload":{"regime":{"root":"{root}","layout":"scripts","suite_path":[],"testpaths":[],"pythonpath":[],"marker_declared":false,"has_config":false,"conftests":[],"colliding_conftests":[],"generated_conftests":[],"config_file":"","root_resolves":false,"target":null,"module":null,"shadow":null},"applied":[],"decision":{"verb":"regime","code":"migration_available","route":"","step":{"kind":"run","argv":["regime","--migrate","--project-root","{root}"],"then":null,"remedy":""},"plan":null,"residual":null,"optional":[],"state":{"blocked":[],"needed":true},"final":null},"exit_code":0,"exit_meaning":"clean"},"ledger":{"args":{},"dur_ms":4,"env":{"detective":"{home}/tools/Detective/Detective/__init__.py","interpreter":"{home}/Projects/SquishOS/.venv/bin/python","project_